# Copier vers .env : cp .env.example .env

APP_NAME=Salles
NAME=salle
FULLNAME=salle_gatien-duboc_fr
DOMAIN=salle.gatien-duboc.fr
API_DOMAIN=api.salle.gatien-duboc.fr

MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=salles
MYSQL_USER=salles
MYSQL_PASSWORD=changeme_db
MYSQL_DATABASE_TEST=salles_test

JWT_SECRET=changeme-generer-avec-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
